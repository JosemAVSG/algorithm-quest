  "workshop": { "systemId": "sys.sorter", "from": "working", "to": "reliable" },
  "briefing": {
    "headline": "De la más ligera a la más pesada",
    "body": "Llegan cajas con pesos desordenados y hay que colocarlas en una estantería **de la más ligera a la más pesada**. El encargado tiene un procedimiento fijo: mira **todas las cajas que quedan**, saca la más ligera, la pone al final de la fila ya colocada, y repite hasta que no queda ninguna.\n\nRecibes la lista de pesos y devuelves una **lista nueva** con los mismos pesos en orden ascendente. La lista original **no se toca**: otro turno la sigue usando.\n\nLos pesos pueden repetirse y pueden ser negativos (una devolución resta). **No se puede usar `.sort`**: lo que se evalúa es que sepas colocar las cajas tú mismo.",
    "requirements": ["Recibe una lista de pesos (números, pueden repetirse y ser negativos)", "Devuelve una lista nueva con los mismos pesos, de menor a mayor", "No modifica la lista recibida", "No usa .sort ni .toSorted"],
    "forbiddenVocabulary": ["selección", "ordenación", "burbuja", "ordenar por"]
  },
  "contract": {
    "entryPoint": "sortByLightest",
    "signature": "sortByLightest(weights) -> number[]",
    "inputShape": "weights: number[]",
    "outputShape": "number[]",
    "rules": ["El resultado contiene exactamente los mismos valores que weights, de menor a mayor", "Los valores repetidos aparecen tantas veces como en weights", "Devuelve una lista nueva y no modifica weights", "Una lista vacía devuelve []", "No se permiten .sort ni .toSorted"]
  },
  "constraints": { "bannedConstructs": [".sort", "toSorted"], "allowClosedForm": false, "mustNotMutate": true },
  "starterCode": "function sortByLightest(weights) {\n  // your code here\n}\n",
