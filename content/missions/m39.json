  "workshop": { "systemId": "sys.merger", "from": "working", "to": "reliable" },
  "briefing": {
    "headline": "Ordenar miles de piezas sin recorrerlas mil veces",
    "body": "El procedimiento de la misión anterior (sacar siempre la más ligera) funciona, pero con miles de piezas tarda demasiado. Hay una forma de ordenar mucho más barata:\n\n1. Toma la **primera pieza** como referencia.\n2. Reparte las demás en dos montones: las que pesan **lo mismo o menos** que la referencia, y las que pesan **más**.\n3. Cada montón se ordena **con este mismo procedimiento**.\n4. El resultado es: montón de las ligeras, la referencia, montón de las pesadas.\n\nRecibes la lista de pesos y devuelves una **lista nueva** ordenada de menor a mayor. La original no se toca. **No se puede usar `.sort`.**\n\nLas piezas que pesan lo mismo que la referencia **no se pierden ni se repiten**: cada pieza aparece una vez en el resultado.",
    "requirements": ["Recibe una lista de pesos (pueden repetirse y ser negativos)", "Devuelve una lista nueva con los mismos pesos, de menor a mayor", "No modifica la lista recibida y no usa .sort", "Tiene que funcionar con miles de piezas"],
    "forbiddenVocabulary": ["quicksort", "pivote", "recursión", "recursivo", "divide y vencerás", "partición"]
  },
  "contract": {
    "entryPoint": "arrangeBySplitting",
    "signature": "arrangeBySplitting(weights) -> number[]",
    "inputShape": "weights: number[]",
    "outputShape": "number[]",
    "rules": ["El resultado contiene exactamente los valores de weights, de menor a mayor", "Cada valor aparece tantas veces como en weights, también los iguales a la referencia", "Devuelve una lista nueva y no modifica weights", "Una lista vacía o de un elemento se devuelve tal cual (como copia)", "No se permiten .sort ni .toSorted"]
  },
  "constraints": {
    "bannedConstructs": [".sort", "toSorted"],
    "allowClosedForm": false,
    "mustNotMutate": true,
    "efficiency": { "budgetMs": 200, "calibrated": true, "enforced": false, "operationBudget": 300000 }
  },
