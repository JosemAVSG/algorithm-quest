{
  "name": "algorithm-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Educational game that teaches algorithmic pattern recognition through a workshop simulator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:content": "tsx scripts/validate-content.ts",
    "content:index": "tsx scripts/build-content-index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run validate:content && npm run test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "acorn": "8.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.187.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
